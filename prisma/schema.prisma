// Cascadia Pigeon Rescue — Operations Management
// Phase 1 MVP schema (intentionally pragmatic, not over-normalized).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ========================================================================
// BIRDS
// ========================================================================
model Bird {
  id                    String    @id @default(cuid())
  name                  String
  species               String? // pigeon, dove, etc.
  breed                 String?
  age                   String? // free-text: hatchling / juvenile / adult / 3 mo / etc.
  sex                   String? // M / F / Unknown
  weightGrams           Float?
  bandInfo              String?
  intakeDate            DateTime  @default(now())
  // Date the bird was found (separate from intake). Partial-date triple:
  // Year required, Month + Day optional, so callers can say
  // "2024" or "March 2024" or "March 15, 2024".
  foundDateYear         Int?
  foundDateMonth        Int? // 1..12 when present
  foundDateDay          Int? // 1..31 when present
  foundLocation         String?
  finderName            String?
  finderContact         String?
  status                String    @default("needs_intake") // see lib/constants
  placementNeed         String? // urgent_foster / quarantine / medical / etc.
  medicalPriority       String    @default("none") // none / low / medium / high / critical
  // Quarantine + integration tracking (replaces the old `quarantine` status).
  // A bird can be quarantined while also having any clinical status, so the
  // state lives on its own boolean instead of conflating two axes in `status`.
  currentlyQuarantined  Boolean   @default(false)
  clearedForIntegration Boolean   @default(false)
  // Projected date the bird is expected to clear quarantine. Same partial-date
  // triple pattern as foundDate* (year required, month + day optional).
  projectedClearedYear  Int?
  projectedClearedMonth Int? // 1..12 when present
  projectedClearedDay   Int? // 1..31 when present
  dietNotes             String?
  behaviorNotes         String?
  specialHandling       String?
  outcome               String?
  // Soft-delete / archive
  archivedAt            DateTime?
  deletedAt             DateTime?
  // Medical
  primaryDiagnosis      String?
  contagionRisk         String? // none / low / medium / high
  feedingStatus         String? // self / hand / tube / crop
  heatSupport           Boolean   @default(false)
  medicalNotes          String?
  // PR F (2026-05-18): shared "fully sorted / handled" star. Single
  // boolean visible to every operator (we have one shared admin login
  // right now). When per-user accounts arrive, this can become a M2M
  // table; until then, anyone clicking the star toggles it for the
  // whole team.
  starred               Boolean   @default(false)

  // PR G (2026-05-19) — intake metadata flags.
  // Independent of foundLocation/finderName/finderContact (which stay
  // visible regardless). A bird can be born-in-captivity AND have a
  // "where it came from" address (the breeder, the surrendering owner,
  // etc.), so we keep all fields and let the operator fill what applies.
  bornInCaptivity Boolean @default(false)
  ownerSurrender  Boolean @default(false)

  // PR G — freeform backstory. Soft hint ~2000 chars, hard cap 10000
  // enforced in src/lib/schemas.ts. Plain text for now (no markdown),
  // can upgrade later if Christina wants formatting.
  backstory String?

  // Relations
  fosterId              String?
  foster                Foster?                @relation(fields: [fosterId], references: [id])
  placements            Placement[]
  medications           Medication[]
  requests              Request[]
  dailyUpdates          DailyUpdate[]
  photos                Photo[]
  calendarEvents        CalendarEvent[]
  vetVisits             VetVisit[]
  caseNotes             CaseNote[]
  bandageTasks          BandageTask[]
  transports            TransportRequest[]
  transportRequestLinks TransportRequestBird[]
  transportStopLinks    TransportStopBird[]
  rescuedFromCases      RescueCase[] // PR D: cases where this bird was the rescue subject
  weightLog             WeightEntry[]
  whereaboutsLog        WhereaboutsLogEntry[] // PR G: append-only log of placements/moves
  fosterCheckIns        FosterCheckIn[]       // Phase 1: volunteer portal check-ins

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// PR G (2026-05-19) — Current Whereabouts log.
//
// Append-only log of placements. The "current whereabouts" is computed
// from the most recent entry (highest recordedAt).
//
// The summary displayed on the bird list is DERIVED — from the latest
// log entry if any exist, else falls back to the Bird.status field so
// we don't need to backfill historical birds with a synthetic entry.
// See src/lib/whereabouts.ts for the derivation rules.
//
// Edit/delete on log entries is supported (in case of typo) but the
// model is intended to be append-mostly so we can answer "where was
// this bird on 2026-04-12?" by walking the log.
model WhereaboutsLogEntry {
  id         String   @id @default(cuid())
  birdId     String
  bird       Bird     @relation(fields: [birdId], references: [id], onDelete: Cascade)
  // One of: adopted | in_foster_care | at_sanctuary | at_wildlife_center |
  //         deceased | other
  // Validated by WHEREABOUTS_CATEGORIES in src/lib/constants.ts.
  category   String
  notes      String?
  // When this placement BEGAN. Defaults to creation time but can be
  // back-dated by the operator when logging history.
  recordedAt DateTime @default(now())
  // Who logged it (free-text for now; single shared admin login).
  recordedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([birdId, recordedAt])
}

// ========================================================================
// FOSTERS
// ========================================================================
model Foster {
  id              String  @id @default(cuid())
  name            String
  phone           String?
  email           String?
  address         String?
  photoUrl        String? // profile photo (path under /uploads/fosters/...)
  capacity        Int     @default(0)
  medicalSkill    String  @default("beginner") // rehab proficiency: beginner / intermediate / advanced
  // Date this foster joined the rescue. Partial-date triple
  // (year required, month + day optional). See Bird.foundDate*.
  joinedDateYear  Int?
  joinedDateMonth Int? // 1..12 when present
  joinedDateDay   Int? // 1..31 when present
  longTermAble    Boolean @default(false)
  notes           String?

  // Transport ability (separate section per Rafa)
  canTransportSelf Boolean @default(false)

  // Rehab skills checklist (17 items — score = number checked / 17)
  // The first three map to legacy fields so existing data is preserved.
  skillEnrichment      Boolean @default(false)
  skillOralMeds        Boolean @default(false)
  skillSyringeFeed     Boolean @default(false)
  skillTubeFeed        Boolean @default(false) // was tubeFeedingSkill
  skillQuarantine      Boolean @default(false) // was quarantineAble (renamed)
  skillWoundCare       Boolean @default(false) // was woundCareSkill
  skillNeonates        Boolean @default(false) // was neonateSkill
  skillFootBandages    Boolean @default(false)
  skillBoots           Boolean @default(false)
  skillWingWraps       Boolean @default(false)
  skillSubqFluids      Boolean @default(false)
  skillIMInjections    Boolean @default(false)
  skillCompoundMeds    Boolean @default(false)
  skillCropSwabsFecals Boolean @default(false)
  skillCropFlushes     Boolean @default(false)
  skillCageTime        Boolean @default(false)
  skillBirdLights      Boolean @default(false)
  skillSupplements     Boolean @default(false)
  // Critical-care additions (added with the tiered rubric)
  skillMedKnowledge    Boolean @default(false) // common pigeon meds + safe admin
  skillEmaciationCare  Boolean @default(false) // refeeding safety, rehab, crop mon

  // Live state
  whiteboardNote String? // persistent urgent standing concern
  currentStress  Int     @default(1) // 1..10 (last logged); convenience copy

  // Soft-delete / archive
  archivedAt DateTime?
  deletedAt  DateTime?

  birds        Bird[]
  placements   Placement[]
  wellness     WellnessLog[]
  requests     Request[]
  dailyUpdates DailyUpdate[]

  // Reverse cross-links — a foster can also drive and/or rescue.
  driverProfile  TransportVolunteer? @relation("FosterAsDriver")
  rescuerProfile RescueVolunteer?    @relation("FosterAsRescuer")

  // Phase 0 (volunteer portal) — reverse link from VolunteerProfile.
  volunteerProfile VolunteerProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========================================================================
// PLACEMENTS
// ========================================================================
model Placement {
  id               String    @id @default(cuid())
  birdId           String
  bird             Bird      @relation(fields: [birdId], references: [id], onDelete: Cascade)
  fosterId         String
  foster           Foster    @relation(fields: [fosterId], references: [id], onDelete: Cascade)
  startDate        DateTime  @default(now())
  endDate          DateTime?
  reason           String? // initial / transfer / quarantine / medical / etc.
  transferReason   String?
  transportDetails String?
  suppliesSent     String?
  notes            String?
  status           String    @default("active") // active / ended

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========================================================================
// MEDICATIONS
// ========================================================================
model Medication {
  id              String    @id @default(cuid())
  birdId          String
  bird            Bird      @relation(fields: [birdId], references: [id], onDelete: Cascade)
  name            String
  dose            String?
  // Units the dose is expressed in (mg / ml / drops / tablets / capsules
  // / IU / mcg). Free-text so Christina can type something we haven't
  // seen, but the form datalist suggests the common set + anything in
  // MedicationCatalog.defaultUnits.
  units           String?
  concentration   String?
  route           String? // PO / SC / IM / topical / nebulized
  frequency       String? // once daily, BID, TID, etc.
  startDate       DateTime  @default(now())
  stopDate        DateTime?
  reassessDate    DateTime?
  amountDispensed Float?
  daysSupplied    Int?
  expectedRunOut  DateTime?
  refillPrepared  Boolean   @default(false)
  refillDelivered Boolean   @default(false)
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========================================================================
// WEIGHT LOG (ongoing weight entries per bird)
// ========================================================================
// Replaces the single Bird.weightGrams field as the source of truth.
// Bird.weightGrams is kept as a denormalised "latest weight" cache so
// existing list views and dashboards keep working without a join.
model WeightEntry {
  id         String   @id @default(cuid())
  birdId     String
  bird       Bird     @relation(fields: [birdId], references: [id], onDelete: Cascade)
  grams      Float
  measuredAt DateTime @default(now())
  notes      String?
  createdAt  DateTime @default(now())

  @@index([birdId, measuredAt])
}

// ========================================================================
// FOSTER WELLNESS LOG
// ========================================================================
model WellnessLog {
  id                 String  @id @default(cuid())
  fosterId           String
  foster             Foster  @relation(fields: [fosterId], references: [id], onDelete: Cascade)
  stressLevel        Int // 1..10
  capacityConfidence Int? // 1..10
  needsRehome        Boolean @default(false)
  needsSupplies      Boolean @default(false)
  needsLeadership    Boolean @default(false)
  burnoutWarning     Boolean @default(false)
  notes              String?

  createdAt DateTime @default(now())
}

// ========================================================================
// REQUESTS (foster portal)
// ========================================================================
model Request {
  id          String  @id @default(cuid())
  fosterId    String
  foster      Foster  @relation(fields: [fosterId], references: [id], onDelete: Cascade)
  birdId      String?
  bird        Bird?   @relation(fields: [birdId], references: [id])
  type        String // supply / medication / bandage / transport / vet / food / equipment / other
  urgency     String  @default("normal") // low / normal / high / urgent
  description String
  status      String  @default("open") // open / in_progress / resolved / closed
  assignedTo  String?
  resolution  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========================================================================
// DAILY FOSTER UPDATES
// ========================================================================
model DailyUpdate {
  id               String  @id @default(cuid())
  birdId           String
  bird             Bird    @relation(fields: [birdId], references: [id], onDelete: Cascade)
  fosterId         String
  foster           Foster  @relation(fields: [fosterId], references: [id], onDelete: Cascade)
  healthStatus     String?
  eatingDrinking   String?
  poopQuality      String?
  energyLevel      String?
  medsAdministered String?
  stressLevel      Int?
  concerns         String?
  whiteboardUpdate String?
  notes            String?

  photos DailyUpdatePhoto[]

  createdAt DateTime @default(now())
}

// ========================================================================
// PHOTOS
// ========================================================================
model Photo {
  id           String   @id @default(cuid())
  birdId       String
  bird         Bird     @relation(fields: [birdId], references: [id], onDelete: Cascade)
  url          String
  caption      String?
  // Categorization: general gallery, health record, vet paperwork
  category     String   @default("general") // general | health | vet
  // Treats this as the bird's profile photo when true (one per bird)
  isProfile    Boolean  @default(false)
  // Optional notes (used heavily by health + vet entries)
  notes        String?
  // Original file metadata
  originalName String?
  mimeType     String?
  // Marker for uploads that aren't images (e.g. PDFs in vet paperwork)
  kind         String   @default("image") // image | document
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Photos attached to a daily update (separate from the bird's main gallery).
model DailyUpdatePhoto {
  id            String      @id @default(cuid())
  dailyUpdateId String
  dailyUpdate   DailyUpdate @relation(fields: [dailyUpdateId], references: [id], onDelete: Cascade)
  url           String
  caption       String?
  originalName  String?
  mimeType      String?
  createdAt     DateTime    @default(now())
}

// ========================================================================
// CASE NOTES
// ========================================================================
model CaseNote {
  id        String   @id @default(cuid())
  birdId    String
  bird      Bird     @relation(fields: [birdId], references: [id], onDelete: Cascade)
  author    String?
  body      String
  createdAt DateTime @default(now())
}

// ========================================================================
// CALENDAR
// ========================================================================
model CalendarEvent {
  id       String    @id @default(cuid())
  title    String
  type     String // vet / bandage / med_start / med_stop / med_reassess / refill / supply / transfer / adoption / followup
  startsAt DateTime
  endsAt   DateTime?
  birdId   String?
  bird     Bird?     @relation(fields: [birdId], references: [id])
  notes    String?
  done     Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========================================================================
// VET VISITS
// ========================================================================
model VetVisit {
  id        String   @id @default(cuid())
  birdId    String
  bird      Bird     @relation(fields: [birdId], references: [id], onDelete: Cascade)
  visitDate DateTime
  vetName   String?
  diagnosis String?
  treatment String?
  followup  String?
  cost      Float?
  notes     String?

  createdAt DateTime @default(now())
}

// ========================================================================
// PHASE 2: TRANSPORT
// ========================================================================
model TransportVolunteer {
  id             String  @id @default(cuid())
  name           String
  phone          String?
  email          String?
  location       String?
  vehicleType    String? // sedan / SUV / pickup / van / etc.
  maxDistanceMi  Int? // willingness in miles
  medicalCapable Boolean @default(false)
  availability   String? // free-text or weekly pattern
  notes          String?

  // Cross-link to other directories so the same person isn't duplicated.
  // A person who's both a foster and a driver shares one Foster record;
  // their TransportVolunteer record references it via linkedFosterId.
  linkedFosterId String? @unique
  linkedFoster   Foster? @relation("FosterAsDriver", fields: [linkedFosterId], references: [id])

  requests       TransportRequest[]
  availabilities TransportAvailability[]
  shifts         TransportShift[]

  // Phase 0 (volunteer portal) — reverse link.
  volunteerProfile VolunteerProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------------------------
// Availability blocks for a transport volunteer (driver). A row with
// rrule == null is a one-off block. A row with rrule != null is the
// template for a recurring availability; startsAt/endsAt define the
// FIRST occurrence's time-of-day + duration, and the recurrence pattern
// fans out from there (expanded by the rrule lib at render time).
// ------------------------------------------------------------------
model TransportAvailability {
  id          String             @id @default(cuid())
  volunteerId String
  volunteer   TransportVolunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  startsAt    DateTime
  endsAt      DateTime
  rrule       String? // iCal RRULE string when this is a recurring template
  notes       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([volunteerId, startsAt])
}

// ------------------------------------------------------------------
// Scheduled transport shifts (NOT to be confused with TransportRequest,
// which is the per-job pickup→deliver assignment). A shift is a block of
// time a driver is on duty / scheduled for transport work.
// ------------------------------------------------------------------
model TransportShift {
  id          String              @id @default(cuid())
  volunteerId String?
  volunteer   TransportVolunteer? @relation(fields: [volunteerId], references: [id], onDelete: SetNull)
  startsAt    DateTime
  endsAt      DateTime
  rrule       String? // when recurring
  role        String? // free text — "Long-haul", "Local", "Pickup", etc.
  notes       String?
  status      String              @default("scheduled") // scheduled / in_progress / completed / cancelled / no_show
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([volunteerId, startsAt])
  @@index([startsAt])
}

model TransportRequest {
  id          String    @id @default(cuid())
  // NEW (PR C): optional title for multi-stop requests. Legacy rows leave
  // this null; UI shows a fallback like "Transport request" when null.
  title       String?
  // NEW (PR C): free-text type (vet / intake / transfer / surrender / other).
  type        String?
  birdId      String?
  bird        Bird?     @relation(fields: [birdId], references: [id], onDelete: SetNull)
  // LEGACY single-stop fields. Made nullable in PR C so new multi-stop
  // requests can leave them blank. Existing data is preserved; render the
  // detail page with a "migrate to multi-stop" banner when these are set
  // and there are no TransportStop rows.
  fromAddress String?
  toAddress   String?
  pickupBy    DateTime?
  deliverBy   DateTime?
  description String?
  urgency     String    @default("normal") // low / normal / high / urgent
  status      String    @default("open") // open / assigned / in_transit / delivered / cancelled
  notes       String?

  volunteerId String?
  volunteer   TransportVolunteer? @relation(fields: [volunteerId], references: [id])

  // PR C: multi-stop + multi-bird (back-compat: legacy rows have neither).
  stops TransportStop[]
  birds TransportRequestBird[]

  // Phase 1 (dispatch core). See RescueCase for field semantics; same
  // shape, polymorphic dispatch engine treats both uniformly.
  emergencyFlag        Boolean @default(false)
  deadline             DateTime?
  figuredOutAt         DateTime?
  pointPersonId        String?
  pointPerson          VolunteerProfile? @relation("TransportRequestPointPerson", fields: [pointPersonId], references: [id], onDelete: SetNull)
  pointPersonClaimedAt DateTime?

  // PR H (2026-05-24): resolution audit for the Undo-close feature.
  resolvedAt          DateTime?
  resolvedByProfileId String?
  resolvedReversedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resolvedAt])
}

// ------------------------------------------------------------------
// PR C: a single stop in a multi-stop transport request. `kind` says
// whether this is a pickup or a dropoff. Location + times are nullable
// so Christina can create a shell to fill in later ("we know there's
// a pickup but not where/when yet"). timeEnd is null for a single time;
// non-null means a window from timeStart to timeEnd.
// ------------------------------------------------------------------
model TransportStop {
  id        String           @id @default(cuid())
  requestId String
  request   TransportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  kind      String // "pickup" | "dropoff"
  location  String?
  timeStart DateTime?
  timeEnd   DateTime?
  notes     String?
  sortOrder Int              @default(0)

  birds TransportStopBird[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requestId, sortOrder])
}

// ------------------------------------------------------------------
// PR C: many-to-many between TransportRequest and Bird. Replaces the
// legacy single `birdId` for multi-bird requests. Legacy rows continue
// to use TransportRequest.birdId until edited.
// ------------------------------------------------------------------
model TransportRequestBird {
  requestId String
  birdId    String
  request   TransportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  bird      Bird             @relation(fields: [birdId], references: [id], onDelete: Cascade)

  @@id([requestId, birdId])
}

// ------------------------------------------------------------------
// PR C: optional per-stop bird assignment, for the "some birds picked
// up at vet, others dropped off elsewhere" case. MVP UI doesn't expose
// this yet; the table is here so we don't need another migration to
// turn it on later.
// ------------------------------------------------------------------
model TransportStopBird {
  stopId String
  birdId String
  stop   TransportStop @relation(fields: [stopId], references: [id], onDelete: Cascade)
  bird   Bird          @relation(fields: [birdId], references: [id], onDelete: Cascade)

  @@id([stopId, birdId])
}

// ========================================================================
// PHASE 2: RESCUE SHIFTS
// ========================================================================
model RescueVolunteer {
  id                String  @id @default(cuid())
  name              String
  phone             String?
  email             String?
  location          String?
  skills            String? // free text — climbing / netting / first-aid / driver / etc.
  emergencyResponse Boolean @default(false)
  availability      String?
  notes             String?

  // Cross-link to Foster so a foster who also does rescue isn't duplicated.
  linkedFosterId String? @unique
  linkedFoster   Foster? @relation("FosterAsRescuer", fields: [linkedFosterId], references: [id])

  shifts         RescueShift[]
  availabilities RescueAvailability[]
  assignedCases  RescueCase[] // PR D: rescue cases assigned to this volunteer

  // Phase 0 (volunteer portal) — reverse link.
  volunteerProfile VolunteerProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========================================================================
// PHASE 2: RESCUE CASES (PR D)
//
// A RescueCase is a bird-in-the-field that's been reported but not yet
// brought into the rescue. Distinct from RescueShift (which is a
// volunteer's on-call window) and from Bird (which is a bird already in
// the system). When a case ends with the bird successfully rescued,
// Christina can convert it to a Bird record — the case keeps a
// rescuedBirdId pointer so we don't lose the history.
//
// Status workflow:
//   needs_rescue → rescued | escaped_flew_away | closed_unable
//
// All fields except `status` are nullable so Christina can log a sighting
// with whatever info she has and fill in the rest as it comes in.
// ========================================================================
model RescueCase {
  id     String @id @default(cuid())
  status String @default("needs_rescue")
  // needs_rescue / rescued / escaped_flew_away / closed_unable

  // What's being rescued
  birdDescription String? // "blue bar pigeon"
  issue           String? // "broken wing, can't fly"

  // Where
  location String? // human-readable, e.g. "parking garage on 7th and Spring"
  address  String? // canonical address if known

  // Reporter info
  dateCalledIn    DateTime @default(now())
  reporterName    String?
  reporterPhone   String?
  reporterContact String? // catch-all: email / IG handle / other

  // Last-seen tracking (separate from initial sighting, may be updated later)
  lastSeenAt       DateTime?
  lastSeenLocation String?
  lastSeenNotes    String?

  notes String?

  // When the bird is rescued + brought into the system, this points to
  // the newly-created Bird record. Nullable for cases still in progress
  // or that escaped/closed without a Bird being created.
  rescuedBirdId String?
  rescuedBird   Bird?   @relation(fields: [rescuedBirdId], references: [id], onDelete: SetNull)

  // Assigned rescuer(s) — MVP supports single assignment; many-to-many
  // could come in a later PR.
  assignedVolunteerId String?
  assignedVolunteer   RescueVolunteer? @relation(fields: [assignedVolunteerId], references: [id], onDelete: SetNull)

  // Phase 1 (dispatch core).
  //
  // emergencyFlag: explicit emergency flag. True = always emergency,
  //   regardless of deadline.
  // deadline: when the case has to be acted on by. Implicit emergency
  //   fires when (deadline - now) < 30 min.
  // figuredOutAt: a coordinator or Point Person tapped "figured out"
  //   to close escalations without changing status (e.g. "on my way,
  //   don't fan-out further").
  // pointPersonId: claimed Point Person (VolunteerProfile), not
  //   auto-set. Null until someone taps Claim Point Person.
  emergencyFlag        Boolean @default(false)
  deadline             DateTime?
  figuredOutAt         DateTime?
  pointPersonId        String?
  pointPerson          VolunteerProfile? @relation("RescueCasePointPerson", fields: [pointPersonId], references: [id], onDelete: SetNull)
  pointPersonClaimedAt DateTime?

  // PR H (2026-05-24): "Unable to rescue" no longer closes the case.
  // When a Point Person hits Unable, we record their reason here,
  // unset pointPersonId, re-open the case to needs_rescue, and re-dispatch
  // to the next-nearest volunteers + coordinators.
  unableReason       String?
  unablePassedCount  Int     @default(0)

  // Audit trail for any close/resolve action (rescued, escaped, closed_unable).
  // Powers the "Undo close" feature: while resolvedAt is recent (and reversedAt
  // is null), the case can be re-opened by the actor or admin.
  resolvedAt         DateTime?
  resolvedByProfileId String?
  resolvedReversedAt DateTime?

  updates RescueCaseUpdate[]
  photos  RescueCasePhoto[]

  // Soft-delete / archive
  archivedAt DateTime?
  deletedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([archivedAt, deletedAt])
  @@index([resolvedAt])
}

// Timeline of attempts / observations / status changes on a case.
// Append-only from the UI; older entries should rarely be edited.
model RescueCaseUpdate {
  id          String     @id @default(cuid())
  caseId      String
  case        RescueCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  text        String
  // Optional: when the attempt/observation happened (may differ from createdAt
  // if Christina is logging a past attempt after the fact).
  attemptedAt DateTime   @default(now())
  authorName  String?
  // PR H (2026-05-24): link timeline entries to the volunteer profile that
  // authored them, so notes added by a Point Person can grant points + show
  // attribution. Nullable for legacy/admin-authored entries.
  authorProfileId String?
  authorProfile   VolunteerProfile? @relation("RescueCaseUpdateAuthor", fields: [authorProfileId], references: [id], onDelete: SetNull)
  // PR H: tag entries that are volunteer-authored field notes (eligible for
  // points) vs. system/admin status changes (not eligible).
  category    String     @default("system") // "system" | "volunteer_note" | "admin"
  createdAt   DateTime   @default(now())

  @@index([caseId, attemptedAt])
}

model RescueCasePhoto {
  id        String     @id @default(cuid())
  caseId    String
  case      RescueCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  createdAt DateTime   @default(now())

  @@index([caseId])
}

// ------------------------------------------------------------------
// Availability blocks for a rescue volunteer. Same shape + semantics
// as TransportAvailability — see that model's comments.
// ------------------------------------------------------------------
model RescueAvailability {
  id          String          @id @default(cuid())
  volunteerId String
  volunteer   RescueVolunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  startsAt    DateTime
  endsAt      DateTime
  rrule       String?
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([volunteerId, startsAt])
}

model RescueShift {
  id        String   @id @default(cuid())
  startsAt  DateTime
  endsAt    DateTime
  // Pre-existing fields (kept for backward compat with the /rescue page):
  shiftType String   @default("on_call") // on_call / active / emergency_backup
  area      String?
  notes     String?
  // PR-B additions: recurrence + role + status workflow.
  rrule     String? // when recurring
  role      String? // free text — "Catch", "Field assist", etc.
  status    String   @default("scheduled") // scheduled / in_progress / completed / cancelled / no_show

  volunteerId String?
  volunteer   RescueVolunteer? @relation(fields: [volunteerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([volunteerId, startsAt])
  @@index([startsAt])
}

// ========================================================================
// PHASE 2: SUPPLY INVENTORY
// ========================================================================
model Supply {
  id         String  @id @default(cuid())
  name       String
  category   String? // food / medical / housing / cleaning / paperwork
  unit       String? // lb / box / each / mL
  onHand     Float   @default(0)
  threshold  Float   @default(0) // alert if onHand <= threshold
  reorderUrl String?
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========================================================================
// MEDICATION CATALOG (autocomplete source)
// ========================================================================
// Phase-1 scope: name + units only. Christina types a med name on a
// bird's record; if it's new, we add it here so the next time the same
// name pops up in the combobox. `defaultUnits` is whatever units were
// typed on the first occurrence — surfaced as the suggested default
// when the name is reused.
model MedicationCatalog {
  id           String   @id @default(cuid())
  name         String   @unique
  defaultUnits String? // mg / ml / drops / tablets / capsules / IU / mcg
  createdAt    DateTime @default(now())
}

// ========================================================================
// PHASE 2: BANDAGE TASKS (recurring per bird)
// ========================================================================
model BandageTask {
  id           String    @id @default(cuid())
  birdId       String
  bird         Bird      @relation(fields: [birdId], references: [id], onDelete: Cascade)
  description  String
  intervalDays Int       @default(2)
  nextDueAt    DateTime
  lastDoneAt   DateTime?
  active       Boolean   @default(true)
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========================================================================
// PHASE 0 (Volunteer Portal) — IDENTITY & EVENT MODELS
// ========================================================================
//
// VolunteerProfile is the identity anchor for the volunteer portal. One
// row per human. Role tags are stored as a JSON-ish string column (
// comma-separated keys) so we don't need a separate join table for the
// 13 role types in the spec. We pick a denormalised column over a join
// because:
//   • SQLite doesn't enforce check constraints on enum-likes anyway
//   • the role list is small and read on every page load
//   • adding/removing a role is a single UPDATE
//
// The existing Foster / TransportVolunteer / RescueVolunteer tables
// stay where they are. A VolunteerProfile can reference each of the
// three role tables via nullable FK, so the per-role data (skills,
// vehicle, etc.) keeps living in its original home and we don't have
// to migrate any of the existing UI off those tables.
//
// Foster / TransportVolunteer / RescueVolunteer all already have an
// `email` column. For Phase 0 the email column on VolunteerProfile is
// the source of truth for sign-in; the role-table email columns become
// denormalised copies (kept in sync when the profile is created from
// an existing role row).
// ========================================================================
model VolunteerProfile {
  id    String @id @default(cuid())
  email String @unique
  phone String?
  name  String

  // Role tags. Comma-separated keys from a fixed vocabulary in
  // src/lib/volunteer/roles.ts. Examples: "foster", "transport",
  // "rescue", "coordinator", "lead_foster", etc. The first 13 from
  // the spec are the initial set.
  roleTags String @default("")

  // Coordinator flag — only real permission split per the spec. A
  // coordinator sees the dispatch board for everyone in the roles
  // they coordinate; a non-coordinator sees only their own.
  isCoordinator Boolean @default(false)

  // Optional links to legacy role records so we keep showing the
  // per-role data (skills, vehicle, etc.) on the right pages. All
  // three are unique → at most one of each per profile.
  fosterId    String? @unique
  foster      Foster? @relation(fields: [fosterId], references: [id])
  transportId String? @unique
  transport   TransportVolunteer? @relation(fields: [transportId], references: [id])
  rescueId    String? @unique
  rescue      RescueVolunteer? @relation(fields: [rescueId], references: [id])

  // Onboarding state — set when the admin creates the profile but
  // before the volunteer has clicked their first magic link.
  invitedAt    DateTime?
  lastLoginAt  DateTime?
  disabledAt   DateTime? // soft-disable (preserves history)

  // Phase 1.5: opt-in daily digest SMS. Default off. Volunteer toggles
  // on /v/profile.
  digestEnabled Boolean @default(false)

  magicLinks VolunteerMagicLink[]
  events     VolunteerEvent[]

  // Phase 1 (dispatch core).
  availability   VolunteerAvailability[]
  assignments    Assignment[]
  pointPersonOnRescue   RescueCase[]      @relation("RescueCasePointPerson")
  pointPersonOnTransport TransportRequest[] @relation("TransportRequestPointPerson")
  rescueUpdatesAuthored RescueCaseUpdate[] @relation("RescueCaseUpdateAuthor")
  fosterCheckIns FosterCheckIn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------------------------
// Magic-link tokens for passwordless sign-in. One row per issued link.
//
// Token is a 32-byte URL-safe random string (generated in
// src/lib/volunteer/magic-link.ts). We store the SHA-256 hash, not the
// raw token, so a DB leak doesn't grant sign-in. Tokens are single-use
// (consumedAt) and expire 30 minutes after issue.
// ------------------------------------------------------------------
model VolunteerMagicLink {
  id          String   @id @default(cuid())
  profileId   String
  profile     VolunteerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique
  // What the link should land on after sign-in. Validated to be a
  // same-origin path before redirect.
  redirectTo  String   @default("/")
  // Audit: IP + user-agent at issue time. Lightweight forensics if a
  // link is misused.
  issuedIp    String?
  issuedUa    String?
  expiresAt   DateTime
  consumedAt  DateTime?

  createdAt DateTime @default(now())

  @@index([profileId, createdAt])
}

// ------------------------------------------------------------------
// SMS ledger — every send, real or stubbed, gets a row. Powers the
// monthly $-ceiling guard in lib/notify/sms.ts and gives us an audit
// trail ("did Christina actually get the rescue alert?").
// ------------------------------------------------------------------
model SmsLedger {
  id               String   @id @default(cuid())
  to               String
  body             String
  tag              String?
  dedupeKey        String?
  provider         String   // "stub" | "twilio"
  providerSid      String?
  estimatedCostUsd Float    @default(0)
  status           String   // "sent_stub" | "queued" | "sent" | "delivered" | "failed" | "error:<code>"

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([dedupeKey, createdAt])
}

// ------------------------------------------------------------------
// VolunteerEvent — append-only log of point-earning + audit events.
//
// We log from day 1 even though the scoring UI is Phase 2, so no data
// is lost. `category` is broad (rescue / transport / foster / check_in
// / admin), `kind` is the specific event key, `pointDelta` is what the
// rules engine assigned at time of logging (may be 0 for audit-only).
// `approvalStatus` is "auto" (under threshold, banked immediately),
// "pending" (above threshold, in Christina's queue), or "approved" /
// "rejected" / "adjusted".
//
// `refType` + `refId` are a soft foreign key — e.g. ("RescueCase",
// case.id) — used to render "this came from rescue case X" without a
// hard FK to every model.
// ------------------------------------------------------------------
model VolunteerEvent {
  id           String   @id @default(cuid())
  profileId    String
  profile      VolunteerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  category     String   // "rescue" | "transport" | "foster" | "check_in" | "admin" | "system"
  kind         String   // free-text key, e.g. "rescue.claim" / "foster.daily_update"
  pointDelta   Int      @default(0)
  approvalStatus String @default("auto") // auto | pending | approved | rejected | adjusted
  approvedById String?
  approvedAt   DateTime?

  refType String?
  refId   String?

  notes String?

  // PR H (2026-05-24): when a parent action is undone (e.g. case un-closed),
  // we don't delete the original event — we mark it reversed and write a
  // matching offsetting event so balance math stays correct.
  reversedAt     DateTime?
  reversedReason String?

  createdAt DateTime @default(now())

  @@index([profileId, createdAt])
  @@index([approvalStatus, createdAt])
  @@index([refType, refId])
}

// ========================================================================
// PHASE 2 — POINT-RULES ENGINE
// ========================================================================
//
// One row per recognized event kind. Christina enables/disables each
// rule and tunes its point value from the admin /volunteers/rules page.
// Disabled rules log the event with pointDelta=0 (preserved for audit
// + future re-enablement).
//
// Phase 2 ships with 40+ rule rows seeded (disabled-by-default), per
// Christina's note: "I'm gonna ask all the volunteers for summaries of
// their contributions so far, have AI approximate points based on that,
// and we will have to just start there." The seeded defaults are
// suggestions only; Christina tunes them before turning them on.
//
// The auto-approve threshold lives in env (POINT_AUTO_APPROVE_MAX) and
// continues to apply per-event: any event with |pointDelta| > threshold
// lands as approvalStatus='pending' regardless of which rule fired it.
// ========================================================================
model PointRule {
  // Same as VolunteerEvent.kind. The dispatch / check-in / resolution
  // flows call evaluateRule(kind) to look this up; rule disabled or
  // missing -> pointDelta=0.
  kind        String @id

  // Human-readable label for the admin UI.
  label       String
  // Free-form text shown beneath the rule in the admin UI.
  description String?
  // Group key for the admin UI ("rescue", "transport", "foster",
  // "check_in", "coordination", "historical").
  category    String

  // Suggested point value (set by code, never overwritten on seed re-run).
  suggestedPoints Int @default(0)
  // Actual point value used when the rule fires. Defaults to suggested
  // on initial seed; admin edits this.
  points          Int @default(0)

  // Per-rule enable flag. When false, evaluateRule returns 0 and the
  // event still logs (audit-only).
  enabled         Boolean @default(false)

  // Per-rule auto-approve override. When set, a |pointDelta| <= this
  // value bypasses the global POINT_AUTO_APPROVE_MAX threshold. Use
  // case: "foster check-ins are never reviewed" => set this to 1.
  autoApproveMax  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========================================================================
// PHASE 1 (Volunteer portal dispatch core) — AVAILABILITY v2
// ========================================================================
//
// One unified availability table tied to VolunteerProfile (not per-role).
// A volunteer can have any number of availability rows; the dispatch
// engine asks "is this volunteer available at time T?" by checking ALL
// of their rows for an overlap.
//
// Five availability kinds (per Christina's spec):
//
//   - one_time   — single [startsAt, endsAt] window. rrule = null.
//   - weekly     — recurring weekly. rrule = "FREQ=WEEKLY;BYDAY=...".
//                  endsAt - startsAt defines the duration; rrule controls
//                  which days/times.
//   - indefinite — same shape as weekly, but the volunteer has explicitly
//                  said "this is my default schedule until further notice"
//                  vs. "this is only for the next 4 weeks". Lifecycle hint;
//                  the engine treats it identically to weekly.
//   - always     — 24/7 availability. startsAt is irrelevant; engine
//                  treats this volunteer as always-on.
//   - custom     — escape hatch: a custom RRULE string.
//
// `availabilityScope` lets a volunteer say "this block is for rescue
// only" or "transport only" or "any" — useful for the volunteer who's
// happy to drive transport on weeknights but only wants rescue alerts on
// weekends.
// ========================================================================
model VolunteerAvailability {
  id        String @id @default(cuid())
  profileId String
  profile   VolunteerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  kind      String  // "one_time" | "weekly" | "indefinite" | "always" | "custom"
  scope     String  @default("any") // "any" | "rescue" | "transport" | "foster_oncall"

  startsAt  DateTime
  endsAt    DateTime
  rrule     String?

  // Optional horizon for "weekly" blocks the volunteer said only runs
  // for a few weeks. Null = no horizon (which for kind="indefinite" or
  // "always" is the whole point).
  effectiveUntil DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId, startsAt])
  @@index([profileId, kind])
}

// ========================================================================
// PHASE 1 — ASSIGNMENT (polymorphic)
// ========================================================================
//
// One row per (Job, VolunteerProfile). When a rescue case or transport
// request is created, the dispatch engine writes one Assignment row for
// every volunteer whose shift overlaps. Point Person is NOT auto-set;
// it's claimed by the first volunteer to tap "Claim Point Person".
//
// Polymorphic via jobType + jobId (matches VolunteerEvent.refType /
// refId pattern). We accept the soft-FK tradeoff so we can extend to
// new job types (e.g. "foster_handoff") without another migration.
//
// Status workflow:
//   notified  — assignment created; volunteer notified (SMS sent).
//   declined  — volunteer tapped Unavailable.
//   claimed   — volunteer tapped Claim Point Person (becomes PP).
//   resolved  — the underlying job reached a terminal status.
// ========================================================================
model Assignment {
  id        String @id @default(cuid())
  jobType   String // "RescueCase" | "TransportRequest"
  jobId     String
  profileId String
  profile   VolunteerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  status     String   @default("notified")
  notifiedAt DateTime @default(now())
  declinedAt DateTime?
  claimedAt  DateTime?
  resolvedAt DateTime?

  // Which dispatch reason produced this assignment. Audit-only; not
  // queried in the hot path.
  source String   @default("shift_overlap") // "shift_overlap" | "emergency_broadcast" | "escalation" | "manual"

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobType, jobId])
  @@index([profileId, status])
  @@unique([jobType, jobId, profileId])
}

// ========================================================================
// PHASE 1 — ESCALATION
// ========================================================================
//
// Each escalation "tier" gets its own row. Lifecycle:
//
//   tier 1 (volunteers)  — created when the job is created. tierExpiresAt
//                          set 15 min out (or 2 min for Point Person claim
//                          deadline once shift starts). If a claim happens
//                          before tierExpiresAt, this row is closedAt =
//                          now() with outcome = "claimed".
//   tier 2 (coordinator) — created when tier 1 expires unclaimed. SMS
//                          fired to all coordinators. 15-min window.
//   tier 3 (christina)   — created when tier 2 expires unhandled. SMS
//                          fired to christina@cascadiapigeonrescue.org
//                          (env CHRISTINA_PHONE).
//
// Emergency fast-path bypasses tier 1 entirely: when emergencyFlag is
// true OR deadline-now < 30 min, the job creator emits THREE simultaneous
// tier rows (volunteers + coordinators + christina) all open at once.
// First claim closes all three. This matches Christina's note: "deadline
// less than 30 min away → sent directly to me + coordinators + transport."
// ========================================================================
model Escalation {
  id      String @id @default(cuid())
  jobType String // "RescueCase" | "TransportRequest"
  jobId   String

  tier    Int    // 1 (volunteers) | 2 (coordinator) | 3 (christina)
  reason  String @default("timer") // "timer" | "emergency" | "manual" | "no_claim"

  openedAt    DateTime @default(now())
  expiresAt   DateTime
  closedAt    DateTime?
  // Closed because: "claimed" | "timed_out" | "job_resolved" | "superseded"
  outcome     String?

  // How many SMS fired for this tier (for ledger debugging).
  smsFanout   Int      @default(0)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobType, jobId, tier])
  @@index([closedAt, expiresAt]) // dispatch sweeper uses this
}

// ========================================================================
// PHASE 1 — FOSTER CHECK-IN
// ========================================================================
//
// Lightweight daily check-in from the volunteer portal. Optional:
// per Christina, "don't punish them for skipping when nothing's wrong,
// but reward them with a point every time they do." The existing
// DailyUpdate model (in admin land) is the heavyweight clinical record;
// FosterCheckIn is the volunteer-side gamified ping.
//
// A check-in references either a bird (if the volunteer is checking on
// a specific bird in their care) or a foster session generally. Logs
// to VolunteerEvent with category="check_in", kind="foster.check_in",
// pointDelta=1.
// ========================================================================
model FosterCheckIn {
  id        String @id @default(cuid())
  profileId String
  profile   VolunteerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  birdId String? // optional; check-in can be generic
  bird   Bird?   @relation(fields: [birdId], references: [id], onDelete: SetNull)

  // Three-tier health pulse + optional note. Matches the existing
  // DailyUpdate.stressLevel / healthStatus / concerns triad but lighter.
  pulse  String  @default("all_good") // "all_good" | "watching" | "concern"
  note   String?

  createdAt DateTime @default(now())

  @@index([profileId, createdAt])
  @@index([birdId, createdAt])
}
